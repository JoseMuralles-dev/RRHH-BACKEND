            }
          },
          "mode": "raw"
        },
        "method": "POST",
        "url": "{{baseUrl}}/ai-tools/resumen-equipo",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ]
      }
    },
    {
